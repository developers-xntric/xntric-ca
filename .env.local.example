# Sanity CMS Configuration
# Get these values from https://sanity.io/manage

# Your Sanity Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"

# Your Sanity Dataset (usually 'production' or 'development')
NEXT_PUBLIC_SANITY_DATASET="production"

# Sanity API Version (format: YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION="2025-10-22"

# Sanity API Token (for write access and draft content)
# Generate this from: https://sanity.io/manage/personal
SANITY_TOKEN="your-sanity-token"
